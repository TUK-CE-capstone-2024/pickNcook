<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/main"
        app:navigationIcon="@drawable/ic_arrow_back"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="레시피 추천"
            android:textAppearance="@style/TitleTextStyle" />
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/fridgeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="냉장고 식재료"
        android:textSize="28sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="@id/fridgeRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/fridgeRecyclerView"
        android:gravity="center"/>

    <!-- 좌 냉장고 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fridgeRecyclerView"
        android:layout_width="0dp"
        android:layout_height="700dp"
        android:paddingTop="30dp"
        android:paddingStart="80dp"
        android:paddingEnd="40dp"
        tools:listitem="@layout/item_food"
        app:layout_constraintTop_toBottomOf="@id/fridgeLabel"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cartRecyclerView"
        app:layout_constraintWidth_percent="0.5" />

    <TextView
        android:id="@+id/cartLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="쇼핑카트 식재료"
        android:textSize="28sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="@id/cartRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/cartRecyclerView"
        android:gravity="center"/>

    <!-- 우 쇼핑카트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cartRecyclerView"
        android:layout_width="0dp"
        android:layout_height="700dp"
        android:paddingTop="30dp"
        android:paddingStart="40dp"
        android:paddingEnd="80dp"
        tools:listitem="@layout/item_shopping"
        app:layout_constraintTop_toBottomOf="@id/cartLabel"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintStart_toEndOf="@id/fridgeRecyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.5" />

    <Button
        android:id="@+id/nextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다음"
        android:textSize="@dimen/button_size"
        android:padding="10dp"
        android:textColor="@color/black"
        android:backgroundTint="@color/main"
        app:layout_constraintTop_toBottomOf="@id/fridgeRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

