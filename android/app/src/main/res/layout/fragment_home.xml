<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/main"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="40dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_alarm_bell"
            android:layout_gravity="end|center_vertical"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="홈"
            android:textAppearance="@style/TitleTextStyle" />
    </androidx.appcompat.widget.Toolbar>

    <ImageView
        android:id="@+id/headerImage"
        android:layout_width="0dp"
        android:layout_height="350dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/header_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- 냉장고 카드 -->
    <FrameLayout
        android:id="@+id/fridgeView"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toBottomOf="@id/headerImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cartView"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="냉장고"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>
    </FrameLayout>


    <!-- 쇼핑카트 카드 -->
    <FrameLayout
        android:id="@+id/cartView"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:background="@drawable/bg_rounded"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toTopOf="@id/fridgeView"
        app:layout_constraintStart_toEndOf="@id/fridgeView"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="쇼핑카트"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>
    </FrameLayout>


    <Button
        android:id="@+id/recipeButton"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/main"
        android:text="레시피 추천"
        android:textColor="@color/black"
        android:textSize="@dimen/button_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cartView" />

</androidx.constraintlayout.widget.ConstraintLayout>

