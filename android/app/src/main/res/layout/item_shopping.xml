<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:minHeight="40dp"
    android:padding="@dimen/food_item_padding"
    android:layout_margin="8dp"
    android:background="@drawable/item_background_selector">

    <!-- 식재료 이름 -->
    <TextView
        android:id="@+id/itemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="식재료 이름"
        android:textSize="@dimen/food_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 식재료 가격 -->
    <TextView
        android:id="@+id/itemPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0원"
        android:textColor="@color/gray"
        android:textSize="@dimen/food_text_size"
        android:paddingEnd="15dp"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/deleteIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 주의 아이콘 -->
    <ImageView
        android:id="@+id/warningIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_warning"
        android:contentDescription="주의"
        app:layout_constraintEnd_toStartOf="@id/itemPrice"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- 삭제 버튼 -->
    <Button
        android:id="@+id/deleteIcon"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="삭제"
        android:textSize="@dimen/button_size"
        android:textColor="@color/black"
        android:backgroundTint="@color/main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
