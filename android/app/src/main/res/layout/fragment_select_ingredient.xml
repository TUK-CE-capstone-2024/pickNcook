<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@color/main"
            app:navigationIcon="@drawable/ic_arrow_back"
            android:paddingStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="레시피 추천"
                android:textAppearance="@style/TitleTextStyle" />
        </androidx.appcompat.widget.Toolbar>

        <TextView
            android:id="@+id/fridgeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="냉장고 식재료"
            android:textSize="@dimen/title1_text_size"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="@id/fridgeRecyclerView"
            app:layout_constraintEnd_toEndOf="@id/fridgeRecyclerView"
            android:gravity="center"/>

        <!-- 좌 냉장고 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fridgeRecyclerView"
            android:layout_width="0dp"
            android:layout_height="450dp"
            android:paddingTop="15dp"
            android:paddingStart="30dp"
            android:paddingEnd="15dp"
            tools:listitem="@layout/item_food"
            android:contentDescription="냉장고에 있는 식재료 목록"
            app:layout_constraintTop_toBottomOf="@id/fridgeLabel"
            app:layout_constraintBottom_toTopOf="@id/nextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cartRecyclerView"
            app:layout_constraintWidth_percent="0.5" />

        <TextView
            android:id="@+id/cartLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="쇼핑카트 식재료"
            android:textSize="@dimen/title1_text_size"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="@id/cartRecyclerView"
            app:layout_constraintEnd_toEndOf="@id/cartRecyclerView"
            android:gravity="center"/>

        <!-- 우 쇼핑카트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cartRecyclerView"
            android:layout_width="0dp"
            android:layout_height="450dp"
            android:paddingTop="15dp"
            android:paddingStart="15dp"
            android:paddingEnd="30dp"
            tools:listitem="@layout/item_shopping"
            android:contentDescription="쇼핑카트에 담긴 식재료 목록"
            app:layout_constraintTop_toBottomOf="@id/cartLabel"
            app:layout_constraintBottom_toTopOf="@id/nextButton"
            app:layout_constraintStart_toEndOf="@id/fridgeRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음"
            android:textSize="@dimen/button_size"
            android:textColor="@color/black"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/main"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fridgeRecyclerView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

